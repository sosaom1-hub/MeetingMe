<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the renewal check every day at 09:30 and at login. The script itself only reinstalls when
     the last install is 5+ days old, so a missed day (iPhone away) is retried the next day.
     REPO_PATH is replaced by docs/free-signing.md step 4. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.meetingrecorder.renew</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPO_PATH/scripts/renew-devices.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/meetingrecorder-renew.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/meetingrecorder-renew.log</string>
</dict>
</plist>
